generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Board {
  id        String   @id @default(cuid())
  name      String   @unique
  classes   Class[]
  createdAt DateTime @default(now())
}

model Class {
  id       String    @id @default(cuid())
  name     String
  boardId  String
  board    Board     @relation(fields: [boardId], references: [id])
  subjects Subject[]
}

model Subject {
  id       String    @id @default(cuid())
  name     String
  classId  String
  class    Class     @relation(fields: [classId], references: [id])
  chapters Chapter[]
}

model Chapter {
  id        String     @id @default(cuid())
  name      String
  number    Int
  subjectId String
  subject   Subject    @relation(fields: [subjectId], references: [id])
  questions Question[]
}

model Question {
  id             String          @id @default(cuid())
  questionId     String?
  type           String?
  difficulty     String?
  marks          Int?
  bloom          String?
  question       String
  answer         String?
  chapterId      String
  chapter        Chapter         @relation(fields: [chapterId], references: [id])
  paperQuestions PaperQuestion[]
}

model Paper {
  id        String          @id @default(cuid())
  title     String
  createdAt DateTime        @default(now())
  questions PaperQuestion[]
}

model PaperQuestion {
  id         String @id @default(cuid())
  paperId    String
  questionId String

  paper    Paper    @relation(fields: [paperId], references: [id])
  question Question @relation(fields: [questionId], references: [id])
}

model Dataset {
  id            String   @id @default(cuid())
  board         String
  class         String
  subject       String
  schema        String?
  questionCount Int
  uploadedAt    DateTime @default(now())
}
